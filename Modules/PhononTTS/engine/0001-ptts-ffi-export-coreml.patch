+/// Export the checkpoint folder `checkpoint` (`config.json`, `model.safetensors`,
+/// `tokenizer.json`) as a Core ML bundle in `out`, which `ptts_new` then loads. `voices` is a
+/// folder of voice `.safetensors` files, or NULL for the checkpoint's own. Returns false on
+/// failure; then `ptts_last_error(NULL)`, on the same thread, says why. Nodus Reader addition.
+///
+/// # Safety
+/// `checkpoint` and `out` must be NUL-terminated UTF-8; `voices` too, or NULL.
+#[cfg(target_vendor = "apple")]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ptts_export_coreml(
+    checkpoint: *const c_char,
+    voices: *const c_char,
+    out: *const c_char,
+) -> bool {
+    let checkpoint = unsafe { CStr::from_ptr(checkpoint) }.to_string_lossy().to_string();
+    let out = unsafe { CStr::from_ptr(out) }.to_string_lossy().to_string();
+    let voices = (!voices.is_null())
+        .then(|| unsafe { CStr::from_ptr(voices) }.to_string_lossy().to_string());
+    let result = guarded(|| {
+        export::export(
+            Path::new(&checkpoint),
+            voices.as_deref().map(Path::new),
+            Path::new(&out),
+            48,
+            0.3,
+        )
+    });
+    match result {
+        Ok(()) => true,
+        Err(e) => {
+            LAST_ERROR.with(|l| *l.borrow_mut() = Some(c_string(&e)));
+            false
+        }
+    }
+}
+
 /// Speak `text`, calling `cb(pcm, n, user)` with each frame's audio as soon as it is decoded.
 /// `out` then describes the whole utterance. Returns false on failure; see `ptts_last_error`.
 ///
