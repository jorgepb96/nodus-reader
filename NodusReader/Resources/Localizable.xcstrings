          "stringUnit": {
            "state": "translated",
            "value": "Cerrar sesión"
          }
        }
      }
    },
    "Sign in to Hugging Face first (Hugging Face section above), with an account that has accepted this model's conditions.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero inicia sesión en Hugging Face (sección Hugging Face, más arriba) con una cuenta que haya aceptado las condiciones de este modelo."
          }
        }
      }
    },
    "Sign in to Hugging Face in your web browser, with the same account as your token.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en Hugging Face en tu navegador con la misma cuenta que tu token."
          }
        }
      }
    },
    "Sign in to iCloud and enable iCloud Drive for Nodus Reader to sync your library.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en iCloud y activa iCloud Drive para Nodus Reader para sincronizar tu biblioteca."
          }
        }
      }
    },
    "Sign in to iCloud on this device to sync your library.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en iCloud en este dispositivo para sincronizar tu biblioteca."
          }
        }
      }
    },
    "Sign in with Hugging Face": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión con Hugging Face"
          }
        }
      }
    },
