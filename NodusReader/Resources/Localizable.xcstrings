    "Sync is off": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronización desactivada"
          }
        }
      }
    },
    "Sync is optional and off by default. Turning it off leaves every local file untouched.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización es opcional y está desactivada de forma predeterminada. Al desactivarla, los archivos locales no se modifican."
          }
        }
      }
    },
    "Sync is optional and off by default. When you enable it, Nodus Reader uses your personal iCloud account through CloudKit and iCloud Drive.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización es opcional y está desactivada de forma predeterminada. Si la activas, Nodus Reader usa tu cuenta personal de iCloud mediante CloudKit e iCloud Drive."
          }
        }
      }
    },
