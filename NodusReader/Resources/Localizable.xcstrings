    },
    "“%@” could not be opened. The file may be damaged or protected.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir «%@». Puede que el archivo esté dañado o protegido."
          }
        }
      }
    },
    "“%@” could not be read from where it is stored. If it is in iCloud Drive or another cloud service, open it once in Files so it downloads to this device, then import it again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer «%@» desde donde está guardado. Si está en iCloud Drive u otro servicio en la nube, ábrelo una vez en Archivos para que se descargue en este dispositivo y vuelve a importarlo."
          }
        }
      }
    },
    "“%@” does not contain readable text.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no contiene texto legible."
          }
        }
      }
    },
    "“%@” is not a supported document format.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no tiene un formato de documento compatible."
          }
        }
      }
    },
    "“%@” is protected with DRM. Nodus Reader does not remove DRM; import a DRM-free copy of the book.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» está protegido con DRM. Nodus Reader no elimina el DRM; importa una copia del libro sin DRM."
          }
        }
      }
    },
    "“%@” is too large to import safely on this device.": {
