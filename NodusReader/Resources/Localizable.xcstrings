            "value": "Voz generada en este %@"
          }
        }
      }
    },
    "Voice models, audio caches, OCR caches and credentials stay on the device that created them. They are excluded from iCloud sync.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos de voz, las cachés de audio y de OCR y las credenciales se quedan en el dispositivo que los creó. Están excluidos de la sincronización con iCloud."
          }
        }
      }
    },
    "Voice models, generated audio and OCR caches are device-local by design. They are excluded from backup and never enter iCloud.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos de voz, el audio generado y las cachés de OCR son locales del dispositivo. Están excluidos de las copias de seguridad y nunca pasan por iCloud."
          }
        }
      }
    },
    "Voices": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voces"
          }
        }
      }
    },
