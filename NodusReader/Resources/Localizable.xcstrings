            "value": "Tamaño del texto: %lld puntos"
          }
        }
      }
    },
    "That document is already in your library": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese documento ya está en tu biblioteca"
          }
        }
      }
    },
    "The %@ engine is not loaded. Open Settings › Voices & Models and install it again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor %@ no está cargado. Abre Ajustes › Voces y modelos e instálalo de nuevo."
          }
        }
      }
    },
    "The Nodus mark is reused under the MIT licence from Nodus Drift. ZIPFoundation is used under the MIT licence. Nodus Reader is not affiliated with Apple.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El logotipo de Nodus se reutiliza de Nodus Drift con licencia MIT. ZIPFoundation se usa con licencia MIT. Nodus Reader no está afiliado a Apple."
          }
        }
      }
    },
    "The built-in themes remain available.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los temas incluidos siguen disponibles."
          }
        }
      }
    },
    "The clip can last 30 seconds at most. Use one of 6 to 15 seconds.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El clip puede durar como máximo 30 segundos. Usa uno de 6 a 15 segundos."
          }
        }
      }
    },
    "The clip needs at least 3 seconds of speech.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El clip necesita al menos 3 segundos de voz."
          }
        }
      }
    },
    "The collection and its subcollections are removed. Documents stay in your library.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan la colección y sus subcolecciones. Los documentos se quedan en tu biblioteca."
          }
        }
      }
    },
    "The collection and its subcollections are removed. The documents stay in your library.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan la colección y sus subcolecciones. Los documentos se quedan en tu biblioteca."
          }
        }
      }
    },
    "The document could not be downloaded from iCloud.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido descargar el documento de iCloud."
          }
        }
      }
    },
    "The document is not available in iCloud yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento aún no está disponible en iCloud."
          }
        }
      }
    },
    "The document stays on this device. Nothing is uploaded.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento se queda en este dispositivo. No se sube nada."
          }
        }
      }
    },
    "The download goes straight to this device. Your books, notes and audio are never sent to Hugging Face.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga va directamente a este dispositivo. Tus libros, notas y audio nunca se envían a Hugging Face."
          }
        }
      }
    },
    "The downloaded document does not match the library metadata. Try downloading it again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento descargado no coincide con los datos de la biblioteca. Vuelve a descargarlo."
          }
        }
      }
    },
    "The iCloud download took too long. Check your connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga de iCloud ha tardado demasiado. Comprueba tu conexión e inténtalo de nuevo."
          }
        }
      }
    },
    "The import was cancelled.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha cancelado la importación."
          }
        }
      }
    },
    "The neural engine returned audio in an unsupported format.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor neuronal ha devuelto audio en un formato no compatible."
          }
        }
      }
    },
    "The neural engine returned no audio.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor neuronal no ha devuelto audio."
          }
        }
      }
    },
    "The reader follows the App appearance.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El lector sigue la apariencia de la app."
          }
        }
      }
    },
    "The recap could not be written. Try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo escribir el resumen. Inténtalo de nuevo."
          }
        }
      }
    },
    "The recording could not start. Check that a microphone is connected.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo empezar a grabar. Comprueba que hay un micrófono conectado."
          }
        }
      }
    },
    "The sign-in response did not match this request. Try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta del inicio de sesión no corresponde a esta solicitud. Inténtalo de nuevo."
          }
        }
      }
    },
    "The simplest way: sign in": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La forma más sencilla: iniciar sesión"
          }
        }
      }
    },
    "The source is published under AGPL-3.0-only so the privacy claims above can be audited.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código fuente se publica con licencia AGPL-3.0-only para que cualquiera pueda comprobar estas garantías de privacidad."
          }
        }
      }
    },
    "The story so far": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La historia hasta aquí"
          }
        }
      }
    },
    "The token could not be saved in the Keychain (status %d).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar el token en el llavero (estado %d)."
          }
        }
      }
    },
    "The token is stored in this device's Keychain only. It is not synced with iCloud and Nodus Reader does not send it anywhere except Hugging Face. You can remove it here, or delete it on the Access Tokens page, at any time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El token se guarda solo en el llavero de este dispositivo. No se sincroniza con iCloud y Nodus Reader solo lo envía a Hugging Face. Puedes quitarlo aquí, o borrarlo en la página Access Tokens, cuando quieras."
          }
        }
      }
    },
    "The voice chosen for this book is not installed on this device": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz elegida para este libro no está instalada en este dispositivo"
          }
        }
      }
    },
    "The words could not be recognized automatically. Type them, exactly as spoken.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron reconocer las palabras automáticamente. Escríbelas tal como se dicen."
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema"
          }
        }
      }
    },
    "Theme applies to": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tema se aplica a"
          }
        }
      }
    },
    "Theme name": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre del tema"
          }
        }
      }
    },
    "There are no analytics, advertising SDKs, tracking pixels or usage reports. The app does not collect identifiers.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay analíticas, SDK de publicidad, píxeles de seguimiento ni informes de uso. La app no recoge identificadores."
          }
        }
      }
    },
    "They are written again the next time you ask for a recap.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vuelven a escribir la próxima vez que pidas un resumen."
          }
        }
      }
    },
    "Third-party notices": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisos de terceros"
          }
        }
      }
    },
    "This book has no iCloud copy yet.": {
      "localizations": {
        "es": {
