          "stringUnit": {
            "state": "translated",
            "value": "Sesión iniciada en Hugging Face como %@."
          }
        }
      }
    },
    "Signed out. To revoke Nodus Reader's access completely, remove it under Connected Apps in your Hugging Face settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión cerrada. Para retirar del todo el acceso de Nodus Reader, quítalo en Connected Apps, en los ajustes de Hugging Face."
          }
        }
      }
