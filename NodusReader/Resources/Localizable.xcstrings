        }
      }
    },
    "This book only": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo este libro"
          }
        }
      }
    },
    "This book uses a voice chosen on another device. %@ reads it here until that voice is installed; voices and models are downloaded separately on each device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este libro usa una voz elegida en otro dispositivo. Aquí lo lee %@ hasta que instales esa voz; las voces y los modelos se descargan por separado en cada dispositivo."
          }
        }
      }
    },
    "This build has analysed the first %lld of %lld pages. The original PDF remains available in full.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión ha analizado las primeras %1$lld de %2$lld páginas. El PDF original sigue disponible completo."
