    "%@ did not match the expected file. Nothing was installed; retry the download.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no coincide con el archivo esperado. No se ha instalado nada; vuelve a descargarlo."
          }
        }
      }
    },
    "%@ is published by Gradium with a gated licence. To download it, sign in to Hugging Face and accept Gradium's conditions on the model's page with the same account. The guide explains each step.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradium publica %@ con una licencia restringida. Para descargarlo, inicia sesión en Hugging Face y acepta las condiciones de Gradium en la página del modelo con la misma cuenta. La guía explica cada paso."
          }
        }
      }
    },
