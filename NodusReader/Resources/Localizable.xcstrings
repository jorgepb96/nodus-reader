          }
        }
      }
    },
    "No, not for the voices you can download in this version. Kokoro 82M and Phonon 31M are public: anyone can download them without an account or a token.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No para las voces que puedes descargar en esta versión. Kokoro 82M y Phonon 31M son públicas: cualquiera puede descargarlas sin cuenta ni token."
          }
        }
      }
    },
    "Nodus Reader": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodus Reader"
          }
        }
      }
    },
    "Nodus Reader cannot use the microphone. Allow it in System Settings › Privacy & Security › Microphone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodus Reader no puede usar el micrófono. Permítelo en Ajustes del Sistema › Privacidad y seguridad › Micrófono."
          }
        }
      }
    },
    "Nodus Reader could not determine the state of your iCloud account.": {
      "localizations": {
