            "state": "translated",
            "value": "Este libro aún no tiene copia en iCloud."
          }
        }
      }
    },
    "This book is stored in iCloud. Enable iCloud sync in Settings to download it on this device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este libro está guardado en iCloud. Activa la sincronización con iCloud en Ajustes para descargarlo en este dispositivo."
